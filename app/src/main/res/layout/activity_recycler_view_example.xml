<?xml version="1.0" encoding="utf-8"?>
<!-- 整体根布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RecyclerView 示例"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- 概念讲解说明 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RecyclerView 是 ListView 的加强版并且已经完全取代了ListView。它强制要求开发者使用 ViewHolder 模式，能够自动复用滑出屏幕的 View 内存，大幅提升列表的流畅度和性能！"
        android:layout_marginBottom="16dp" />

    <!-- 优势展示区域：操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="插入数据(享用动画)" />

        <Button
            android:id="@+id/btnRemove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="删除首行(享用动画)" />
    </LinearLayout>

    <!-- 
         定义 RecyclerView 控件
         注意：由于 RecyclerView 属于 AndroidX 支持库的内容，所以它的全名带有包名（androidx.recyclerview.widget.RecyclerView）
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/myRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
